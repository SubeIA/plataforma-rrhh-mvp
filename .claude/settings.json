{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(chmod 777*)",
      "Bash(eval*)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch"
    ]
  }
}
