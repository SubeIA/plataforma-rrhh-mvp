rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserPermissions() {
      let data = getUserData();
      return data.keys().hasAll(['permissions']) ? data.permissions : [];
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() in ['admin', 'super_admin', 'SUPER_ADMIN'];
    }

    function hasPermission(perm) {
      return isSignedIn() && (perm in getUserPermissions() || getUserRole() in ['super_admin', 'SUPER_ADMIN']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Users ──
    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('manage_users') || hasPermission('manage_attendance');
      allow create: if hasPermission('manage_users');
      allow update: if hasPermission('manage_users') ||
                       (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions']));
      allow delete: if hasPermission('manage_users');
    }

    // ── Profiles ──
    match /profiles/{userId} {
      allow read: if isOwner(userId) || hasPermission('manage_users') || hasPermission('manage_attendance');
      allow create, update: if isOwner(userId) || hasPermission('manage_users');
      allow delete: if hasPermission('manage_users');
    }

    // ── Daily Attendance ──
    match /daily_attendance/{recordId} {
      allow read: if isSignedIn() &&
                     (resource.data.user_id == request.auth.uid || hasPermission('manage_attendance'));
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_attendance');
      allow delete: if hasPermission('manage_attendance');
    }

    // ── Attendance Logs ──
    match /attendance_logs/{logId} {
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || hasPermission('manage_attendance'));
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_attendance');
      allow delete: if hasPermission('manage_attendance');
    }

    // ── Attendance (legacy) ──
    match /attendance/{logId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || hasPermission('manage_attendance'));
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_attendance');
      allow delete: if hasPermission('manage_attendance');
    }

    // ── Requests (leave, permissions, etc.) ──
    match /requests/{requestId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || hasPermission('approve_requests'));
      allow create: if isSignedIn();
      allow update: if hasPermission('approve_requests');
      allow delete: if hasPermission('approve_requests');
    }

    // ── Documents ──
    match /documents/{docId} {
      allow read: if isSignedIn() &&
                     (resource.data.user_id == request.auth.uid || hasPermission('manage_documents'));
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_documents');
      allow delete: if hasPermission('manage_documents');
    }

    // ── Shifts ──
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasPermission('manage_shifts');
    }

    // ── Shift assignments ──
    match /shift_assignments/{assignmentId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || hasPermission('manage_shifts'));
      allow create, update, delete: if hasPermission('manage_shifts');
    }

    // ── Medical licenses ──
    match /medical_licenses/{licenseId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || hasPermission('manage_medical_licenses'));
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_medical_licenses');
      allow delete: if hasPermission('manage_medical_licenses');
    }

    // ── Karin (sensitive - restricted to admin) ──
    match /karin_reports/{reportId} {
      allow read: if hasPermission('view_karin_reports');
      allow create: if isSignedIn();
      allow update: if hasPermission('manage_karin_reports');
      allow delete: if false;
    }

    // ── ITAM (IT Asset Management) ──
    match /itam_assets/{assetId} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('manage_itam');
      allow delete: if hasPermission('manage_itam');
    }

    // ── Audit log (append-only, admin read) ──
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Analytics (read-only for privileged) ──
    match /analytics/{docId} {
      allow read: if hasPermission('view_analytics');
      allow write: if isAdmin();
    }

    // ── Notifications ──
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    // ── Deny everything else by default (no wildcard) ──
  }
}
